{% extends "base.html.twig" %}

{% block title %}Feed de Notícias{% endblock %}

{% block content %}
<div class="row news-page">
    <main class="col-md-9">
        <div class="row">
            {% for n in news %}
                {% if n.headline is not empty %}
                    <section
                        id="{{ n.site }}-{{ n.section }}"
                        class="col-md-6 news-section"
                    >
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <strong>{{ n.site|capitalize }}</strong>
                                <span class="pull-right">{{ n.section|capitalize }}</span>
                            </div>

                            <div class="list-group">
                                {% for h in n.headline %}
                                    <article class="list-group-item">
                                        <h4 class="list-group-item-heading">
                                            <a href="{{ h.link }}" target="_blank" rel="noopener">
                                                {{ h.title }}
                                            </a>
                                        </h4>

                                        {% if h.description %}
                                            <p class="list-group-item-text">
                                                {{ h.description|slice(0, 180) }}
                                                {% if h.description|length > 180 %}…{% endif %}
                                            </p>
                                        {% endif %}
                                    </article>
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                {% endif %}
            {% else %}
                <div class="col-md-12">
                    <div class="alert alert-info">
                        No news could be loaded for this source.
                    </div>
                </div>
            {% endfor %}
        </div>
    </main>

    <aside class="col-md-3">

        {% set logos = {
            'uol': 'uol.jpg',
            'terra': 'terra.jpg',
            'g1': 'g1.jpg',
            'r7': 'r7.jpg',
            'ig': 'ig.jpg',
            'folha': 'folha.jpg',
            'bbc': 'bbc.jpg',
            'estadao': 'estadao.jpg',
            'yahoo': 'yahoo.png'
        } %}

        {% if current_site != 'all' and logos[current_site] is defined %}
            <img
                class="logo img-responsive"
                src="img/{{ logos[current_site] }}"
                alt="{{ current_site|capitalize }}"
            >
        {% endif %}

        <h3>
            {% if current_site == 'all' %}
                Todas as fontes
            {% else %}
                {{ current_site|capitalize }}
            {% endif %}
        </h3>

        <p class="text-muted">
            <small>Última atualização: {{ hour }}</small>
        </p>

        <button
            class="btn btn-default btn-sm"
            type="button"
            onclick="window.location.reload()"
        >
            Atualizar
        </button>

        {% if current_site != 'all' %}
            <div class="space"></div>

            <div class="painel">
                <ul class="nav nav-pills nav-stacked">
                    <li>
                        <a href="#{{ current_site }}-principal">Principais Notícias</a>
                    </li>
                    <li>
                        <a href="#{{ current_site }}-politica">Política</a>
                    </li>
                    <li>
                        <a href="#{{ current_site }}-economia">Economia</a>
                    </li>
                    <li>
                        <a href="#{{ current_site }}-esporte">Esporte</a>
                    </li>
                    <li>
                        <a href="#{{ current_site }}-mundo">Mundo</a>
                    </li>
                </ul>
            </div>
        {% endif %}
    </aside>
</div>
{% endblock %}